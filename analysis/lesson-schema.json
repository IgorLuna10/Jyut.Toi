{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CantoneseLessonSchema",
  "description": "Standardized schema for hand-authored and AI-generated Cantonese language lessons and exercises.",
  "type": "object",
  "required": [
    "id",
    "title",
    "level",
    "topic",
    "exercises"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique lesson identifier (e.g., 'lesson_dining_dimsum_01' or 'ai_gen_u12_049')"
    },
    "unit_id": {
      "type": "string",
      "description": "Parent unit or thematic module identifier"
    },
    "title": {
      "type": "string",
      "description": "Human-readable lesson title in English"
    },
    "title_cantonese": {
      "type": "string",
      "description": "Title in Traditional Cantonese Chinese"
    },
    "title_jyutping": {
      "type": "string",
      "description": "Standard Jyutping transcription for the title"
    },
    "level": {
      "type": "string",
      "enum": ["A1", "A2", "B1", "B2"],
      "description": "CEFR proficiency target"
    },
    "topic": {
      "type": "string",
      "enum": [
        "food_dining",
        "transportation",
        "shopping_bargaining",
        "daily_routines",
        "housing_living",
        "work_technology",
        "social_family",
        "emergency_medical",
        "culture_slang"
      ]
    },
    "target_grammar": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Grammatical patterns reinforced (e.g., ['zo2_aspect', 'hai2_locative'])"
    },
    "target_vocabulary": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of target Hanzi words introduced in this lesson"
    },
    "estimated_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30,
      "default": 5
    },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ExerciseItem"
      }
    }
  },
  "$defs": {
    "ExerciseItem": {
      "type": "object",
      "required": ["id", "type", "prompt"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique exercise identifier"
        },
        "type": {
          "type": "string",
          "enum": [
            "multiple_choice",
            "listening_comprehension",
            "tone_discrimination",
            "sentence_scramble",
            "slot_substitution",
            "character_flashcard",
            "dialogue_roleplay",
            "ai_conversational_freestyle",
            "story_comprehension"
          ]
        },
        "prompt": {
          "type": "string",
          "description": "Primary instructional prompt displayed to the learner"
        },
        "target_content": {
          "$ref": "#/$defs/CantoneseContent"
        },
        "audio_config": {
          "$ref": "#/$defs/AudioConfig"
        },
        "options": {
          "type": "array",
          "description": "Answer options for multiple choice or selection drills",
          "items": {
            "$ref": "#/$defs/AnswerOption"
          }
        },
        "correct_option_id": {
          "type": "string",
          "description": "The option ID representing the correct answer"
        },
        "scramble_data": {
          "$ref": "#/$defs/ScrambleData"
        },
        "tone_data": {
          "$ref": "#/$defs/ToneDrillData"
        },
        "slot_data": {
          "$ref": "#/$defs/SlotSubstitutionData"
        },
        "dialogue_turns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DialogueTurn"
          }
        },
        "explanation": {
          "type": "string",
          "description": "Linguistic or cultural rationale shown after answer submission"
        }
      }
    },
    "CantoneseContent": {
      "type": "object",
      "required": ["hanzi", "jyutping", "english"],
      "properties": {
        "hanzi": {
          "type": "string",
          "description": "Traditional Cantonese Chinese characters"
        },
        "hanzi_simplified": {
          "type": "string",
          "description": "Simplified Chinese equivalent"
        },
        "jyutping": {
          "type": "string",
          "description": "Space-separated Jyutping with tone digits 1-6"
        },
        "english": {
          "type": "string",
          "description": "English translation or definition"
        },
        "literal_gloss": {
          "type": "array",
          "description": "Token-by-token literal translation breakdown",
          "items": {
            "type": "object",
            "required": ["token", "jyutping", "gloss"],
            "properties": {
              "token": { "type": "string" },
              "jyutping": { "type": "string" },
              "gloss": { "type": "string" }
            }
          }
        }
      }
    },
    "AudioConfig": {
      "type": "object",
      "properties": {
        "speech_text": {
          "type": "string",
          "description": "Exact text dispatched to the native TTS engine"
        },
        "voice_locale": {
          "type": "string",
          "default": "zh-HK"
        },
        "speech_rate": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1.5,
          "default": 0.9
        },
        "ambient_noise": {
          "type": "string",
          "enum": ["none", "wet-market", "cha-chaan-teng", "street-traffic"],
          "default": "none"
        },
        "ambient_volume": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.25
        }
      }
    },
    "AnswerOption": {
      "type": "object",
      "required": ["id", "text"],
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "jyutping": { "type": "string" },
        "hanzi": { "type": "string" }
      }
    },
    "ScrambleData": {
      "type": "object",
      "required": ["tokens", "correct_order_indices"],
      "properties": {
        "tokens": {
          "type": "array",
          "description": "Scrambled list of Hanzi token tiles including distractors",
          "items": { "type": "string" }
        },
        "correct_order_indices": {
          "type": "array",
          "description": "0-based indices in 'tokens' that form the correct sentence",
          "items": { "type": "integer" }
        }
      }
    },
    "ToneDrillData": {
      "type": "object",
      "required": ["target_tone", "candidate_pair"],
      "properties": {
        "target_tone": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "candidate_pair": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": ["hanzi", "jyutping", "tone", "english"],
            "properties": {
              "hanzi": { "type": "string" },
              "jyutping": { "type": "string" },
              "tone": { "type": "integer" },
              "english": { "type": "string" }
            }
          }
        },
        "correct_index": {
          "type": "integer",
          "enum": [0, 1]
        }
      }
    },
    "SlotSubstitutionData": {
      "type": "object",
      "required": ["formula", "slots"],
      "properties": {
        "formula": {
          "type": "string",
          "description": "Readable pattern formula (e.g. 'Subject + 喺 + Place + Verb')"
        },
        "fixed_tokens": {
          "type": "array",
          "items": { "type": "string" }
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["slot_key", "category", "options", "correct_index"],
            "properties": {
              "slot_key": { "type": "string" },
              "category": { "type": "string" },
              "options": {
                "type": "array",
                "items": { "$ref": "#/$defs/CantoneseContent" }
              },
              "correct_index": { "type": "integer" }
            }
          }
        }
      }
    },
    "DialogueTurn": {
      "type": "object",
      "required": ["speaker", "speaker_name", "hanzi", "jyutping", "english"],
      "properties": {
        "speaker": {
          "type": "string",
          "enum": ["bot", "user"]
        },
        "speaker_name": {
          "type": "string"
        },
        "hanzi": {
          "type": "string"
        },
        "jyutping": {
          "type": "string"
        },
        "english": {
          "type": "string"
        },
        "user_branch_choices": {
          "type": "array",
          "description": "Options provided when it is the user's turn to speak",
          "items": {
            "type": "object",
            "required": ["id", "hanzi", "jyutping", "english"],
            "properties": {
              "id": { "type": "string" },
              "hanzi": { "type": "string" },
              "jyutping": { "type": "string" },
              "english": { "type": "string" },
              "pragmatic_tone": {
                "type": "string",
                "enum": ["polite", "colloquial_casual", "direct", "slang"]
              }
            }
          }
        }
      }
    }
  }
}
